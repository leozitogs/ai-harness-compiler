{
  "$defs": {
    "Asset": {
      "additionalProperties": false,
      "properties": {
        "description": {
          "minLength": 1,
          "title": "Description",
          "type": "string"
        },
        "path": {
          "minLength": 1,
          "title": "Path",
          "type": "string"
        }
      },
      "required": [
        "path",
        "description"
      ],
      "title": "Asset",
      "type": "object"
    },
    "BacklogItem": {
      "additionalProperties": false,
      "properties": {
        "acceptance_criteria": {
          "items": {
            "minLength": 1,
            "type": "string"
          },
          "minItems": 1,
          "title": "Acceptance Criteria",
          "type": "array"
        },
        "data_owner": {
          "anyOf": [
            {
              "minLength": 1,
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Data Owner"
        },
        "depends_on": {
          "items": {
            "pattern": "^[a-z][a-z0-9_-]{0,63}$",
            "type": "string"
          },
          "title": "Depends On",
          "type": "array"
        },
        "description": {
          "minLength": 1,
          "title": "Description",
          "type": "string"
        },
        "id": {
          "pattern": "^[a-z][a-z0-9_-]{0,63}$",
          "title": "Id",
          "type": "string"
        },
        "implementation": {
          "default": "undecided",
          "enum": [
            "undecided",
            "deterministic",
            "llm",
            "rag",
            "agent"
          ],
          "title": "Implementation",
          "type": "string"
        },
        "inputs": {
          "items": {
            "minLength": 1,
            "type": "string"
          },
          "title": "Inputs",
          "type": "array"
        },
        "outputs": {
          "items": {
            "minLength": 1,
            "type": "string"
          },
          "title": "Outputs",
          "type": "array"
        },
        "risk": {
          "default": "unknown",
          "enum": [
            "unknown",
            "low",
            "medium",
            "high"
          ],
          "title": "Risk",
          "type": "string"
        },
        "side_effects": {
          "items": {
            "minLength": 1,
            "type": "string"
          },
          "title": "Side Effects",
          "type": "array"
        },
        "title": {
          "minLength": 1,
          "title": "Title",
          "type": "string"
        }
      },
      "required": [
        "id",
        "title",
        "description",
        "acceptance_criteria"
      ],
      "title": "BacklogItem",
      "type": "object"
    },
    "Branding": {
      "additionalProperties": false,
      "properties": {
        "audience": {
          "items": {
            "minLength": 1,
            "type": "string"
          },
          "title": "Audience",
          "type": "array"
        },
        "principles": {
          "items": {
            "minLength": 1,
            "type": "string"
          },
          "title": "Principles",
          "type": "array"
        },
        "tone": {
          "items": {
            "minLength": 1,
            "type": "string"
          },
          "title": "Tone",
          "type": "array"
        },
        "visual_constraints": {
          "items": {
            "minLength": 1,
            "type": "string"
          },
          "title": "Visual Constraints",
          "type": "array"
        }
      },
      "title": "Branding",
      "type": "object"
    },
    "Constraints": {
      "additionalProperties": false,
      "properties": {
        "business": {
          "items": {
            "minLength": 1,
            "type": "string"
          },
          "title": "Business",
          "type": "array"
        },
        "max_build_cost_usd": {
          "default": 0,
          "minimum": 0,
          "title": "Max Build Cost Usd",
          "type": "number"
        },
        "security": {
          "items": {
            "minLength": 1,
            "type": "string"
          },
          "title": "Security",
          "type": "array"
        },
        "technical": {
          "items": {
            "minLength": 1,
            "type": "string"
          },
          "title": "Technical",
          "type": "array"
        }
      },
      "title": "Constraints",
      "type": "object"
    },
    "DataProfile": {
      "additionalProperties": false,
      "properties": {
        "contains_pii": {
          "anyOf": [
            {
              "type": "boolean"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Contains Pii"
        },
        "data_types": {
          "items": {
            "minLength": 1,
            "type": "string"
          },
          "title": "Data Types",
          "type": "array"
        },
        "sensitivity": {
          "default": "unknown",
          "enum": [
            "unknown",
            "public",
            "internal",
            "confidential",
            "restricted"
          ],
          "title": "Sensitivity",
          "type": "string"
        }
      },
      "title": "DataProfile",
      "type": "object"
    },
    "DeliveryEvidence": {
      "additionalProperties": false,
      "properties": {
        "content": {
          "anyOf": [
            {
              "maxLength": 262144,
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Content"
        },
        "content_sha256": {
          "anyOf": [
            {
              "pattern": "^[0-9a-f]{64}$",
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Content Sha256"
        },
        "content_trust": {
          "const": "untrusted-reference-data",
          "default": "untrusted-reference-data",
          "title": "Content Trust",
          "type": "string"
        },
        "id": {
          "pattern": "^[a-z][a-z0-9_-]{0,63}$",
          "title": "Id",
          "type": "string"
        },
        "kind": {
          "enum": [
            "project",
            "plan",
            "work-items",
            "policy",
            "memory-index",
            "issue",
            "pull-request"
          ],
          "title": "Kind",
          "type": "string"
        },
        "locator": {
          "maxLength": 512,
          "minLength": 1,
          "title": "Locator",
          "type": "string"
        },
        "number": {
          "anyOf": [
            {
              "minimum": 1,
              "type": "integer"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Number"
        },
        "observed_at": {
          "maxLength": 40,
          "minLength": 1,
          "title": "Observed At",
          "type": "string"
        },
        "project_id": {
          "pattern": "^[a-z][a-z0-9_-]{0,63}$",
          "title": "Project Id",
          "type": "string"
        },
        "reason": {
          "anyOf": [
            {
              "enum": [
                "not-requested",
                "read-failed",
                "limit-exceeded",
                "provider-failed"
              ],
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Reason"
        },
        "repository": {
          "pattern": "^[A-Za-z0-9][A-Za-z0-9_.-]{0,99}/[A-Za-z0-9][A-Za-z0-9_.-]{0,99}$",
          "title": "Repository",
          "type": "string"
        },
        "revision": {
          "anyOf": [
            {
              "maxLength": 200,
              "minLength": 1,
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Revision"
        },
        "schema_version": {
          "const": "DeliveryEvidence/v1",
          "default": "DeliveryEvidence/v1",
          "title": "Schema Version",
          "type": "string"
        },
        "status": {
          "enum": [
            "observed",
            "unavailable"
          ],
          "title": "Status",
          "type": "string"
        }
      },
      "required": [
        "id",
        "project_id",
        "repository",
        "kind",
        "locator",
        "observed_at",
        "status"
      ],
      "title": "DeliveryEvidence",
      "type": "object"
    },
    "DomainHypothesis": {
      "additionalProperties": false,
      "properties": {
        "domain": {
          "minLength": 1,
          "title": "Domain",
          "type": "string"
        },
        "evidence_ids": {
          "items": {
            "pattern": "^[a-z][a-z0-9_-]{0,63}$",
            "type": "string"
          },
          "minItems": 1,
          "title": "Evidence Ids",
          "type": "array"
        },
        "rationale": {
          "minLength": 1,
          "title": "Rationale",
          "type": "string"
        }
      },
      "required": [
        "domain",
        "rationale",
        "evidence_ids"
      ],
      "title": "DomainHypothesis",
      "type": "object"
    },
    "DomainProfile": {
      "additionalProperties": false,
      "properties": {
        "archetype": {
          "anyOf": [
            {
              "minLength": 1,
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Archetype"
        },
        "confidence": {
          "default": null,
          "title": "Confidence",
          "type": "null"
        },
        "data": {
          "$ref": "#/$defs/DataProfile"
        },
        "evidence_ids": {
          "items": {
            "pattern": "^[a-z][a-z0-9_-]{0,63}$",
            "type": "string"
          },
          "title": "Evidence Ids",
          "type": "array"
        },
        "hypotheses": {
          "items": {
            "$ref": "#/$defs/DomainHypothesis"
          },
          "title": "Hypotheses",
          "type": "array"
        },
        "origin": {
          "enum": [
            "user-declaration",
            "supplied-hypothesis",
            "unknown"
          ],
          "title": "Origin",
          "type": "string"
        },
        "primary": {
          "anyOf": [
            {
              "minLength": 1,
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Primary"
        },
        "rationale": {
          "anyOf": [
            {
              "minLength": 1,
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Rationale"
        },
        "risk": {
          "$ref": "#/$defs/RiskProfile"
        },
        "schema_version": {
          "const": "DomainProfile/v1",
          "default": "DomainProfile/v1",
          "title": "Schema Version",
          "type": "string"
        },
        "secondary": {
          "items": {
            "minLength": 1,
            "type": "string"
          },
          "title": "Secondary",
          "type": "array"
        },
        "status": {
          "enum": [
            "declared",
            "hypothesis",
            "DOMAIN_UNCERTAIN"
          ],
          "title": "Status",
          "type": "string"
        }
      },
      "required": [
        "status",
        "origin"
      ],
      "title": "DomainProfile",
      "type": "object"
    },
    "Evidence": {
      "additionalProperties": false,
      "properties": {
        "capability_id": {
          "anyOf": [
            {
              "pattern": "^[a-z][a-z0-9_-]{0,63}$",
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Capability Id"
        },
        "claim": {
          "minLength": 1,
          "title": "Claim",
          "type": "string"
        },
        "id": {
          "pattern": "^[a-z][a-z0-9_-]{0,63}$",
          "title": "Id",
          "type": "string"
        },
        "kind": {
          "enum": [
            "declared",
            "derived",
            "research"
          ],
          "title": "Kind",
          "type": "string"
        },
        "scope": {
          "enum": [
            "project",
            "domain",
            "capability"
          ],
          "title": "Scope",
          "type": "string"
        },
        "source": {
          "minLength": 1,
          "title": "Source",
          "type": "string"
        },
        "source_id": {
          "pattern": "^[a-z][a-z0-9_-]{0,63}$",
          "title": "Source Id",
          "type": "string"
        }
      },
      "required": [
        "id",
        "source_id",
        "source",
        "claim",
        "kind",
        "scope"
      ],
      "title": "Evidence",
      "type": "object"
    },
    "EvidencePack": {
      "additionalProperties": false,
      "properties": {
        "evidence": {
          "items": {
            "$ref": "#/$defs/Evidence"
          },
          "minItems": 1,
          "title": "Evidence",
          "type": "array"
        },
        "schema_version": {
          "const": "EvidencePack/v1",
          "default": "EvidencePack/v1",
          "title": "Schema Version",
          "type": "string"
        },
        "sources": {
          "items": {
            "$ref": "#/$defs/SourceRecord"
          },
          "minItems": 1,
          "title": "Sources",
          "type": "array"
        }
      },
      "required": [
        "sources",
        "evidence"
      ],
      "title": "EvidencePack",
      "type": "object"
    },
    "Impediment": {
      "additionalProperties": false,
      "properties": {
        "code": {
          "pattern": "^[a-z][a-z0-9_-]{0,63}$",
          "title": "Code",
          "type": "string"
        },
        "evidence_ids": {
          "items": {
            "pattern": "^[a-z][a-z0-9_-]{0,63}$",
            "type": "string"
          },
          "maxItems": 256,
          "minItems": 1,
          "title": "Evidence Ids",
          "type": "array"
        },
        "id": {
          "pattern": "^[a-z][a-z0-9_-]{0,63}$",
          "title": "Id",
          "type": "string"
        },
        "message": {
          "minLength": 1,
          "title": "Message",
          "type": "string"
        },
        "schema_version": {
          "const": "Impediment/v1",
          "default": "Impediment/v1",
          "title": "Schema Version",
          "type": "string"
        },
        "severity": {
          "enum": [
            "info",
            "warning",
            "blocker"
          ],
          "title": "Severity",
          "type": "string"
        },
        "story_id": {
          "anyOf": [
            {
              "pattern": "^[a-z][a-z0-9_-]{0,63}$",
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Story Id"
        }
      },
      "required": [
        "id",
        "code",
        "severity",
        "message",
        "evidence_ids"
      ],
      "title": "Impediment",
      "type": "object"
    },
    "ObservedPullRequest": {
      "additionalProperties": false,
      "properties": {
        "checks": {
          "enum": [
            "all-success",
            "failure",
            "pending",
            "unknown"
          ],
          "title": "Checks",
          "type": "string"
        },
        "evidence_id": {
          "pattern": "^[a-z][a-z0-9_-]{0,63}$",
          "title": "Evidence Id",
          "type": "string"
        },
        "head_sha": {
          "pattern": "^[0-9a-f]{40}$",
          "title": "Head Sha",
          "type": "string"
        },
        "number": {
          "minimum": 1,
          "title": "Number",
          "type": "integer"
        },
        "state": {
          "enum": [
            "OPEN",
            "CLOSED",
            "MERGED"
          ],
          "title": "State",
          "type": "string"
        }
      },
      "required": [
        "number",
        "state",
        "head_sha",
        "checks",
        "evidence_id"
      ],
      "title": "ObservedPullRequest",
      "type": "object"
    },
    "ObservedStory": {
      "additionalProperties": false,
      "properties": {
        "acceptance": {
          "const": "not-established",
          "default": "not-established",
          "title": "Acceptance",
          "type": "string"
        },
        "declared_status": {
          "minLength": 1,
          "title": "Declared Status",
          "type": "string"
        },
        "dependencies": {
          "items": {
            "pattern": "^[a-z][a-z0-9_-]{0,63}$",
            "type": "string"
          },
          "maxItems": 128,
          "title": "Dependencies",
          "type": "array"
        },
        "evidence_ids": {
          "items": {
            "pattern": "^[a-z][a-z0-9_-]{0,63}$",
            "type": "string"
          },
          "maxItems": 256,
          "minItems": 1,
          "title": "Evidence Ids",
          "type": "array"
        },
        "id": {
          "pattern": "^[a-z][a-z0-9_-]{0,63}$",
          "title": "Id",
          "type": "string"
        },
        "issue_state": {
          "enum": [
            "OPEN",
            "CLOSED",
            "unknown"
          ],
          "title": "Issue State",
          "type": "string"
        },
        "pull_requests": {
          "items": {
            "$ref": "#/$defs/ObservedPullRequest"
          },
          "maxItems": 128,
          "title": "Pull Requests",
          "type": "array"
        }
      },
      "required": [
        "id",
        "declared_status",
        "issue_state",
        "evidence_ids"
      ],
      "title": "ObservedStory",
      "type": "object"
    },
    "ProjectInput": {
      "additionalProperties": false,
      "properties": {
        "assets": {
          "items": {
            "$ref": "#/$defs/Asset"
          },
          "title": "Assets",
          "type": "array"
        },
        "backlog": {
          "items": {
            "$ref": "#/$defs/BacklogItem"
          },
          "minItems": 1,
          "title": "Backlog",
          "type": "array"
        },
        "branding": {
          "$ref": "#/$defs/Branding"
        },
        "conception": {
          "minLength": 1,
          "title": "Conception",
          "type": "string"
        },
        "constraints": {
          "$ref": "#/$defs/Constraints"
        },
        "domain": {
          "anyOf": [
            {
              "minLength": 1,
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Domain"
        },
        "domain_profile": {
          "anyOf": [
            {
              "$ref": "#/$defs/DomainProfile"
            },
            {
              "type": "null"
            }
          ],
          "default": null
        },
        "evidence_pack": {
          "anyOf": [
            {
              "$ref": "#/$defs/EvidencePack"
            },
            {
              "type": "null"
            }
          ],
          "default": null
        },
        "id": {
          "pattern": "^[a-z][a-z0-9_-]{0,63}$",
          "title": "Id",
          "type": "string"
        },
        "name": {
          "minLength": 1,
          "title": "Name",
          "type": "string"
        },
        "schema_version": {
          "const": "ProjectInput/v1",
          "default": "ProjectInput/v1",
          "title": "Schema Version",
          "type": "string"
        }
      },
      "required": [
        "id",
        "name",
        "conception",
        "backlog"
      ],
      "title": "ProjectInput",
      "type": "object"
    },
    "RiskProfile": {
      "additionalProperties": false,
      "properties": {
        "categories": {
          "items": {
            "enum": [
              "privacy",
              "security",
              "regulatory",
              "hallucination",
              "excessive-agency",
              "availability",
              "cost"
            ],
            "type": "string"
          },
          "title": "Categories",
          "type": "array"
        },
        "level": {
          "default": "unknown",
          "enum": [
            "unknown",
            "low",
            "medium",
            "high"
          ],
          "title": "Level",
          "type": "string"
        }
      },
      "title": "RiskProfile",
      "type": "object"
    },
    "ScrumObservation": {
      "additionalProperties": false,
      "properties": {
        "max_age_seconds": {
          "default": 3600,
          "maximum": 86400,
          "minimum": 1,
          "title": "Max Age Seconds",
          "type": "integer"
        },
        "observed_at": {
          "minLength": 1,
          "title": "Observed At",
          "type": "string"
        },
        "project_id": {
          "pattern": "^[a-z][a-z0-9_-]{0,63}$",
          "title": "Project Id",
          "type": "string"
        },
        "pull_request_links": {
          "items": {
            "$ref": "#/$defs/StoryPRLink"
          },
          "maxItems": 128,
          "title": "Pull Request Links",
          "type": "array"
        },
        "repository": {
          "pattern": "^[A-Za-z0-9][A-Za-z0-9_.-]{0,99}/[A-Za-z0-9][A-Za-z0-9_.-]{0,99}$",
          "title": "Repository",
          "type": "string"
        },
        "schema_version": {
          "const": "ScrumObservation/v1",
          "default": "ScrumObservation/v1",
          "title": "Schema Version",
          "type": "string"
        },
        "sources": {
          "items": {
            "$ref": "#/$defs/DeliveryEvidence"
          },
          "maxItems": 256,
          "minItems": 5,
          "title": "Sources",
          "type": "array"
        },
        "sprint_id": {
          "maxLength": 64,
          "pattern": "^sprint-[1-9][0-9]*(?:-[1-9][0-9]*){0,2}$",
          "title": "Sprint Id",
          "type": "string"
        }
      },
      "required": [
        "project_id",
        "repository",
        "sprint_id",
        "observed_at",
        "sources"
      ],
      "title": "ScrumObservation",
      "type": "object"
    },
    "SourceRecord": {
      "additionalProperties": false,
      "properties": {
        "collected_at": {
          "anyOf": [
            {
              "minLength": 1,
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Collected At"
        },
        "id": {
          "pattern": "^[a-z][a-z0-9_-]{0,63}$",
          "title": "Id",
          "type": "string"
        },
        "location": {
          "minLength": 1,
          "title": "Location",
          "type": "string"
        },
        "origin": {
          "enum": [
            "user-declaration",
            "external-research",
            "compiler-derived"
          ],
          "title": "Origin",
          "type": "string"
        },
        "sha256": {
          "anyOf": [
            {
              "pattern": "^[0-9a-f]{64}$",
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
