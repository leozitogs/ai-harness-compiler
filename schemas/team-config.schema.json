{
  "$defs": {
    "Asset": {
      "additionalProperties": false,
      "properties": {
        "description": {
          "minLength": 1,
          "title": "Description",
          "type": "string"
        },
        "path": {
          "minLength": 1,
          "title": "Path",
          "type": "string"
        }
      },
      "required": [
        "path",
        "description"
      ],
      "title": "Asset",
      "type": "object"
    },
    "BacklogItem": {
      "additionalProperties": false,
      "properties": {
        "acceptance_criteria": {
          "items": {
            "minLength": 1,
            "type": "string"
          },
          "minItems": 1,
          "title": "Acceptance Criteria",
          "type": "array"
        },
        "data_owner": {
          "anyOf": [
            {
              "minLength": 1,
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Data Owner"
        },
        "depends_on": {
          "items": {
            "pattern": "^[a-z][a-z0-9_-]{0,63}$",
            "type": "string"
          },
          "title": "Depends On",
          "type": "array"
        },
        "description": {
          "minLength": 1,
          "title": "Description",
          "type": "string"
        },
        "id": {
          "pattern": "^[a-z][a-z0-9_-]{0,63}$",
          "title": "Id",
          "type": "string"
        },
        "implementation": {
          "default": "undecided",
          "enum": [
            "undecided",
            "deterministic",
            "llm",
            "rag",
            "agent"
          ],
          "title": "Implementation",
          "type": "string"
        },
        "inputs": {
          "items": {
            "minLength": 1,
            "type": "string"
          },
          "title": "Inputs",
          "type": "array"
        },
        "outputs": {
          "items": {
            "minLength": 1,
            "type": "string"
          },
          "title": "Outputs",
          "type": "array"
        },
        "risk": {
          "default": "unknown",
          "enum": [
            "unknown",
            "low",
            "medium",
            "high"
          ],
          "title": "Risk",
          "type": "string"
        },
        "side_effects": {
          "items": {
            "minLength": 1,
            "type": "string"
          },
          "title": "Side Effects",
          "type": "array"
        },
        "title": {
          "minLength": 1,
          "title": "Title",
          "type": "string"
        }
      },
      "required": [
        "id",
        "title",
        "description",
        "acceptance_criteria"
      ],
      "title": "BacklogItem",
      "type": "object"
    },
    "Branding": {
      "additionalProperties": false,
      "properties": {
        "audience": {
          "items": {
            "minLength": 1,
            "type": "string"
          },
          "title": "Audience",
          "type": "array"
        },
        "principles": {
          "items": {
            "minLength": 1,
            "type": "string"
          },
          "title": "Principles",
          "type": "array"
        },
        "tone": {
          "items": {
            "minLength": 1,
            "type": "string"
          },
          "title": "Tone",
          "type": "array"
        },
        "visual_constraints": {
          "items": {
            "minLength": 1,
            "type": "string"
          },
          "title": "Visual Constraints",
          "type": "array"
        }
      },
      "title": "Branding",
      "type": "object"
    },
    "Constraints": {
      "additionalProperties": false,
      "properties": {
        "business": {
          "items": {
            "minLength": 1,
            "type": "string"
          },
          "title": "Business",
          "type": "array"
        },
        "max_build_cost_usd": {
          "default": 0,
          "minimum": 0,
          "title": "Max Build Cost Usd",
          "type": "number"
        },
        "security": {
          "items": {
            "minLength": 1,
            "type": "string"
          },
          "title": "Security",
          "type": "array"
        },
        "technical": {
          "items": {
            "minLength": 1,
            "type": "string"
          },
          "title": "Technical",
          "type": "array"
        }
      },
      "title": "Constraints",
      "type": "object"
    },
    "DataProfile": {
      "additionalProperties": false,
      "properties": {
        "contains_pii": {
          "anyOf": [
            {
              "type": "boolean"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Contains Pii"
        },
        "data_types": {
          "items": {
            "minLength": 1,
            "type": "string"
          },
          "title": "Data Types",
          "type": "array"
        },
        "sensitivity": {
          "default": "unknown",
          "enum": [
            "unknown",
            "public",
            "internal",
            "confidential",
            "restricted"
          ],
          "title": "Sensitivity",
          "type": "string"
        }
      },
      "title": "DataProfile",
      "type": "object"
    },
    "DomainHypothesis": {
      "additionalProperties": false,
      "properties": {
        "domain": {
          "minLength": 1,
          "title": "Domain",
          "type": "string"
        },
        "evidence_ids": {
          "items": {
            "pattern": "^[a-z][a-z0-9_-]{0,63}$",
            "type": "string"
          },
          "minItems": 1,
          "title": "Evidence Ids",
          "type": "array"
        },
        "rationale": {
          "minLength": 1,
          "title": "Rationale",
          "type": "string"
        }
      },
      "required": [
        "domain",
        "rationale",
        "evidence_ids"
      ],
      "title": "DomainHypothesis",
      "type": "object"
    },
    "DomainProfile": {
      "additionalProperties": false,
      "properties": {
        "archetype": {
          "anyOf": [
            {
              "minLength": 1,
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Archetype"
        },
        "confidence": {
          "default": null,
          "title": "Confidence",
          "type": "null"
        },
        "data": {
          "$ref": "#/$defs/DataProfile"
        },
        "evidence_ids": {
          "items": {
            "pattern": "^[a-z][a-z0-9_-]{0,63}$",
            "type": "string"
          },
          "title": "Evidence Ids",
          "type": "array"
        },
        "hypotheses": {
          "items": {
            "$ref": "#/$defs/DomainHypothesis"
          },
          "title": "Hypotheses",
          "type": "array"
        },
        "origin": {
          "enum": [
            "user-declaration",
            "supplied-hypothesis",
            "unknown"
          ],
          "title": "Origin",
          "type": "string"
        },
        "primary": {
          "anyOf": [
            {
              "minLength": 1,
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Primary"
        },
        "rationale": {
          "anyOf": [
            {
              "minLength": 1,
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Rationale"
        },
        "risk": {
          "$ref": "#/$defs/RiskProfile"
        },
        "schema_version": {
          "const": "DomainProfile/v1",
          "default": "DomainProfile/v1",
          "title": "Schema Version",
          "type": "string"
        },
        "secondary": {
          "items": {
            "minLength": 1,
            "type": "string"
          },
          "title": "Secondary",
          "type": "array"
        },
        "status": {
          "enum": [
            "declared",
            "hypothesis",
            "DOMAIN_UNCERTAIN"
          ],
          "title": "Status",
          "type": "string"
        }
      },
      "required": [
        "status",
        "origin"
      ],
      "title": "DomainProfile",
      "type": "object"
    },
    "Evidence": {
      "additionalProperties": false,
      "properties": {
        "capability_id": {
          "anyOf": [
            {
              "pattern": "^[a-z][a-z0-9_-]{0,63}$",
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Capability Id"
        },
        "claim": {
          "minLength": 1,
          "title": "Claim",
          "type": "string"
        },
        "id": {
          "pattern": "^[a-z][a-z0-9_-]{0,63}$",
          "title": "Id",
          "type": "string"
        },
        "kind": {
          "enum": [
            "declared",
            "derived",
            "research"
          ],
          "title": "Kind",
          "type": "string"
        },
        "scope": {
          "enum": [
            "project",
            "domain",
            "capability"
          ],
          "title": "Scope",
          "type": "string"
        },
        "source": {
          "minLength": 1,
          "title": "Source",
          "type": "string"
        },
        "source_id": {
          "pattern": "^[a-z][a-z0-9_-]{0,63}$",
          "title": "Source Id",
          "type": "string"
        }
      },
      "required": [
        "id",
        "source_id",
        "source",
        "claim",
        "kind",
        "scope"
      ],
      "title": "Evidence",
      "type": "object"
    },
    "EvidencePack": {
      "additionalProperties": false,
      "properties": {
        "evidence": {
          "items": {
            "$ref": "#/$defs/Evidence"
          },
          "minItems": 1,
          "title": "Evidence",
          "type": "array"
        },
        "schema_version": {
          "const": "EvidencePack/v1",
          "default": "EvidencePack/v1",
          "title": "Schema Version",
          "type": "string"
        },
        "sources": {
          "items": {
            "$ref": "#/$defs/SourceRecord"
          },
          "minItems": 1,
          "title": "Sources",
          "type": "array"
        }
      },
      "required": [
        "sources",
        "evidence"
      ],
      "title": "EvidencePack",
      "type": "object"
    },
    "ProjectInput": {
      "additionalProperties": false,
      "properties": {
        "assets": {
          "items": {
            "$ref": "#/$defs/Asset"
          },
          "title": "Assets",
          "type": "array"
        },
        "backlog": {
          "items": {
            "$ref": "#/$defs/BacklogItem"
          },
          "minItems": 1,
          "title": "Backlog",
          "type": "array"
        },
        "branding": {
          "$ref": "#/$defs/Branding"
        },
        "conception": {
          "minLength": 1,
          "title": "Conception",
          "type": "string"
        },
        "constraints": {
          "$ref": "#/$defs/Constraints"
        },
        "domain": {
          "anyOf": [
            {
              "minLength": 1,
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Domain"
        },
        "domain_profile": {
          "anyOf": [
            {
              "$ref": "#/$defs/DomainProfile"
            },
            {
              "type": "null"
            }
          ],
          "default": null
        },
        "evidence_pack": {
          "anyOf": [
            {
              "$ref": "#/$defs/EvidencePack"
            },
            {
              "type": "null"
            }
          ],
          "default": null
        },
        "id": {
          "pattern": "^[a-z][a-z0-9_-]{0,63}$",
          "title": "Id",
          "type": "string"
        },
        "name": {
          "minLength": 1,
          "title": "Name",
          "type": "string"
        },
        "schema_version": {
          "const": "ProjectInput/v1",
          "default": "ProjectInput/v1",
          "title": "Schema Version",
          "type": "string"
        }
      },
      "required": [
        "id",
        "name",
        "conception",
        "backlog"
      ],
      "title": "ProjectInput",
      "type": "object"
    },
    "RiskProfile": {
      "additionalProperties": false,
      "properties": {
        "categories": {
          "items": {
            "enum": [
              "privacy",
              "security",
              "regulatory",
              "hallucination",
              "excessive-agency",
              "availability",
              "cost"
            ],
            "type": "string"
          },
          "title": "Categories",
          "type": "array"
        },
        "level": {
          "default": "unknown",
          "enum": [
            "unknown",
            "low",
            "medium",
            "high"
          ],
          "title": "Level",
          "type": "string"
        }
      },
      "title": "RiskProfile",
      "type": "object"
    },
    "SourceRecord": {
      "additionalProperties": false,
      "properties": {
        "collected_at": {
          "anyOf": [
            {
              "minLength": 1,
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Collected At"
        },
        "id": {
          "pattern": "^[a-z][a-z0-9_-]{0,63}$",
          "title": "Id",
          "type": "string"
        },
        "location": {
          "minLength": 1,
          "title": "Location",
          "type": "string"
        },
        "origin": {
          "enum": [
            "user-declaration",
            "external-research",
            "compiler-derived"
          ],
          "title": "Origin",
          "type": "string"
        },
        "sha256": {
          "anyOf": [
            {
              "pattern": "^[0-9a-f]{64}$",
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Sha256"
        },
        "verification_status": {
          "default": "unverified",
          "enum": [
            "unverified",
            "verified",
            "rejected"
          ],
          "title": "Verification Status",
          "type": "string"
        },
        "verified_at": {
          "anyOf": [
            {
              "minLength": 1,
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Verified At"
        },
        "verified_by": {
          "anyOf": [
            {
              "minLength": 1,
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Verified By"
        }
      },
      "required": [
        "id",
        "location",
        "origin"
      ],
      "title": "SourceRecord",
      "type": "object"
    }
  },
  "additionalProperties": false,
  "properties": {
    "engine": {
      "default": "local",
      "enum": [
        "local",
        "ollama"
      ],
      "title": "Engine",
      "type": "string"
    },
    "max_steps": {
      "default": 5,
      "maximum": 10,
      "minimum": 3,
      "title": "Max Steps",
      "type": "integer"
    },
    "mode": {
      "default": "prepare",
      "enum": [
        "prepare",
        "ask"
      ],
      "title": "Mode",
      "type": "string"
    },
    "model": {
      "anyOf": [
        {
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Model"
    },
    "project": {
      "$ref": "#/$defs/ProjectInput"
    },
    "repository_root": {
      "minLength": 1,
      "title": "Repository Root",
      "type": "string"
    },
    "request": {
      "maxLength": 4000,
      "minLength": 1,
      "title": "Request",
      "type": "string"
    },
    "schema_version": {
      "const": "TeamRun/v1",
      "default": "TeamRun/v1",
      "title": "Schema Version",
      "type": "string"
    },
    "selected": {
      "items": {
        "pattern": "^[a-z][a-z0-9_-]{0,63}$",
        "type": "string"
      },
      "minItems": 1,
      "title": "Selected",
      "type": "array"
    }
  },
  "required": [
    "project",
    "selected",
    "request",
    "repository_root"
  ],
  "title": "TeamConfig",
  "type": "object"
}
