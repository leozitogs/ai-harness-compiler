        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Collected At"
    },
    "id": {
      "pattern": "^[a-z][a-z0-9_-]{0,63}$",
      "title": "Id",
      "type": "string"
    },
    "location": {
      "minLength": 1,
      "title": "Location",
      "type": "string"
    },
    "origin": {
