        "external-research",
        "compiler-derived"
      ],
      "title": "Origin",
      "type": "string"
    },
    "sha256": {
      "anyOf": [
        {
          "pattern": "^[0-9a-f]{64}$",
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Sha256"
    },
    "verification_status": {
      "default": "unverified",
      "enum": [
