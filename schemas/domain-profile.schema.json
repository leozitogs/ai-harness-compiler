{
  "$defs": {
    "DataProfile": {
      "additionalProperties": false,
      "properties": {
        "contains_pii": {
          "anyOf": [
            {
              "type": "boolean"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Contains Pii"
        },
        "data_types": {
          "items": {
            "minLength": 1,
            "type": "string"
          },
          "title": "Data Types",
          "type": "array"
        },
        "sensitivity": {
          "default": "unknown",
          "enum": [
            "unknown",
            "public",
            "internal",
            "confidential",
            "restricted"
          ],
          "title": "Sensitivity",
          "type": "string"
        }
      },
      "title": "DataProfile",
      "type": "object"
    },
    "DomainHypothesis": {
      "additionalProperties": false,
      "properties": {
        "domain": {
          "minLength": 1,
          "title": "Domain",
          "type": "string"
        },
        "evidence_ids": {
          "items": {
            "pattern": "^[a-z][a-z0-9_-]{0,63}$",
            "type": "string"
          },
          "minItems": 1,
          "title": "Evidence Ids",
          "type": "array"
        },
        "rationale": {
          "minLength": 1,
          "title": "Rationale",
          "type": "string"
        }
      },
      "required": [
        "domain",
        "rationale",
        "evidence_ids"
      ],
      "title": "DomainHypothesis",
      "type": "object"
    },
    "RiskProfile": {
      "additionalProperties": false,
      "properties": {
        "categories": {
          "items": {
            "enum": [
              "privacy",
              "security",
              "regulatory",
              "hallucination",
              "excessive-agency",
              "availability",
              "cost"
            ],
            "type": "string"
          },
          "title": "Categories",
          "type": "array"
        },
        "level": {
          "default": "unknown",
          "enum": [
            "unknown",
            "low",
            "medium",
            "high"
          ],
          "title": "Level",
          "type": "string"
        }
      },
      "title": "RiskProfile",
      "type": "object"
    }
  },
  "additionalProperties": false,
  "properties": {
    "archetype": {
      "anyOf": [
        {
          "minLength": 1,
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Archetype"
    },
    "confidence": {
      "default": null,
      "title": "Confidence",
      "type": "null"
    },
    "data": {
      "$ref": "#/$defs/DataProfile"
    },
    "evidence_ids": {
      "items": {
        "pattern": "^[a-z][a-z0-9_-]{0,63}$",
        "type": "string"
      },
      "title": "Evidence Ids",
      "type": "array"
    },
    "hypotheses": {
      "items": {
        "$ref": "#/$defs/DomainHypothesis"
      },
      "title": "Hypotheses",
      "type": "array"
    },
    "origin": {
      "enum": [
        "user-declaration",
        "supplied-hypothesis",
        "unknown"
      ],
      "title": "Origin",
      "type": "string"
    },
    "primary": {
      "anyOf": [
        {
          "minLength": 1,
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Primary"
    },
    "rationale": {
      "anyOf": [
        {
          "minLength": 1,
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Rationale"
    },
    "risk": {
      "$ref": "#/$defs/RiskProfile"
    },
    "schema_version": {
      "const": "DomainProfile/v1",
      "default": "DomainProfile/v1",
      "title": "Schema Version",
      "type": "string"
    },
    "secondary": {
      "items": {
        "minLength": 1,
        "type": "string"
      },
      "title": "Secondary",
      "type": "array"
    },
    "status": {
      "enum": [
        "declared",
        "hypothesis",
        "DOMAIN_UNCERTAIN"
      ],
      "title": "Status",
      "type": "string"
    }
  },
  "required": [
    "status",
    "origin"
  ],
  "title": "DomainProfile",
  "type": "object"
}
