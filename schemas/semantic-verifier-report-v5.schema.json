    "AnalysisIssue": {
      "additionalProperties": false,
      "properties": {
        "context_indices": {
          "items": {
            "type": "integer"
          },
          "maxItems": 32,
          "minItems": 1,
          "title": "Context Indices",
          "type": "array"
        },
        "impact": {
          "anyOf": [
            {
              "enum": [
                "rule",
                "authorization",
                "outcome",
                "precedence",
                "implementation-detail"
              ],
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Impact"
        },
        "kind": {
          "enum": [
            "question",
            "conflict",
            "safe-rejection"
          ],
          "title": "Kind",
          "type": "string"
        },
        "rationale": {
          "maxLength": 1000,
          "minLength": 1,
          "title": "Rationale",
          "type": "string"
        },
        "rejection_reason": {
          "anyOf": [
            {
              "enum": [
                "untrusted-instruction",
                "unread-required-source"
              ],
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Rejection Reason"
        },
        "text": {
          "maxLength": 2000,
          "minLength": 1,
          "title": "Text",
          "type": "string"
        }
      },
      "required": [
        "kind",
        "text",
        "context_indices",
        "rationale"
      ],
      "title": "AnalysisIssue",
      "type": "object"
    },
