{
  "$defs": {
    "DeliveryEvidence": {
      "additionalProperties": false,
      "properties": {
        "content": {
          "anyOf": [
            {
              "maxLength": 262144,
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Content"
        },
        "content_sha256": {
          "anyOf": [
            {
              "pattern": "^[0-9a-f]{64}$",
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Content Sha256"
        },
        "content_trust": {
          "const": "untrusted-reference-data",
          "default": "untrusted-reference-data",
          "title": "Content Trust",
          "type": "string"
        },
        "id": {
          "pattern": "^[a-z][a-z0-9_-]{0,63}$",
          "title": "Id",
          "type": "string"
        },
        "kind": {
          "enum": [
            "project",
            "plan",
            "work-items",
            "policy",
            "memory-index",
            "issue",
            "pull-request"
          ],
          "title": "Kind",
          "type": "string"
        },
        "locator": {
          "maxLength": 512,
          "minLength": 1,
          "title": "Locator",
          "type": "string"
        },
        "number": {
          "anyOf": [
            {
              "minimum": 1,
              "type": "integer"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Number"
        },
        "observed_at": {
          "maxLength": 40,
          "minLength": 1,
          "title": "Observed At",
          "type": "string"
        },
        "project_id": {
          "pattern": "^[a-z][a-z0-9_-]{0,63}$",
          "title": "Project Id",
          "type": "string"
        },
        "reason": {
          "anyOf": [
            {
              "enum": [
                "not-requested",
                "read-failed",
                "limit-exceeded",
                "provider-failed"
              ],
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Reason"
        },
        "repository": {
          "pattern": "^[A-Za-z0-9][A-Za-z0-9_.-]{0,99}/[A-Za-z0-9][A-Za-z0-9_.-]{0,99}$",
          "title": "Repository",
          "type": "string"
        },
        "revision": {
          "anyOf": [
            {
              "maxLength": 200,
              "minLength": 1,
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Revision"
        },
        "schema_version": {
          "const": "DeliveryEvidence/v1",
          "default": "DeliveryEvidence/v1",
          "title": "Schema Version",
          "type": "string"
        },
        "status": {
          "enum": [
            "observed",
            "unavailable"
          ],
          "title": "Status",
          "type": "string"
        }
      },
      "required": [
        "id",
        "project_id",
        "repository",
        "kind",
        "locator",
        "observed_at",
        "status"
      ],
      "title": "DeliveryEvidence",
      "type": "object"
    },
    "Impediment": {
      "additionalProperties": false,
      "properties": {
        "code": {
          "pattern": "^[a-z][a-z0-9_-]{0,63}$",
          "title": "Code",
          "type": "string"
        },
        "evidence_ids": {
          "items": {
            "pattern": "^[a-z][a-z0-9_-]{0,63}$",
            "type": "string"
          },
          "maxItems": 256,
          "minItems": 1,
          "title": "Evidence Ids",
          "type": "array"
        },
        "id": {
          "pattern": "^[a-z][a-z0-9_-]{0,63}$",
          "title": "Id",
          "type": "string"
        },
        "message": {
          "minLength": 1,
          "title": "Message",
          "type": "string"
        },
        "schema_version": {
          "const": "Impediment/v1",
          "default": "Impediment/v1",
          "title": "Schema Version",
          "type": "string"
        },
        "severity": {
          "enum": [
            "info",
            "warning",
            "blocker"
          ],
          "title": "Severity",
          "type": "string"
        },
        "story_id": {
          "anyOf": [
            {
              "pattern": "^[a-z][a-z0-9_-]{0,63}$",
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Story Id"
        }
      },
      "required": [
        "id",
        "code",
        "severity",
        "message",
        "evidence_ids"
      ],
      "title": "Impediment",
      "type": "object"
    },
    "ObservedPullRequest": {
      "additionalProperties": false,
      "properties": {
        "checks": {
          "enum": [
            "all-success",
            "failure",
            "pending",
            "unknown"
          ],
          "title": "Checks",
          "type": "string"
        },
        "evidence_id": {
          "pattern": "^[a-z][a-z0-9_-]{0,63}$",
          "title": "Evidence Id",
          "type": "string"
        },
        "head_sha": {
          "pattern": "^[0-9a-f]{40}$",
          "title": "Head Sha",
          "type": "string"
        },
        "number": {
          "minimum": 1,
          "title": "Number",
          "type": "integer"
        },
        "state": {
          "enum": [
            "OPEN",
            "CLOSED",
            "MERGED"
          ],
          "title": "State",
          "type": "string"
        }
      },
      "required": [
        "number",
        "state",
        "head_sha",
        "checks",
        "evidence_id"
      ],
      "title": "ObservedPullRequest",
      "type": "object"
    },
    "ObservedStory": {
      "additionalProperties": false,
      "properties": {
        "acceptance": {
          "const": "not-established",
          "default": "not-established",
          "title": "Acceptance",
          "type": "string"
        },
        "declared_status": {
          "minLength": 1,
          "title": "Declared Status",
          "type": "string"
        },
        "dependencies": {
          "items": {
            "pattern": "^[a-z][a-z0-9_-]{0,63}$",
            "type": "string"
          },
          "maxItems": 128,
          "title": "Dependencies",
          "type": "array"
        },
        "evidence_ids": {
          "items": {
            "pattern": "^[a-z][a-z0-9_-]{0,63}$",
            "type": "string"
          },
          "maxItems": 256,
          "minItems": 1,
          "title": "Evidence Ids",
          "type": "array"
        },
        "id": {
          "pattern": "^[a-z][a-z0-9_-]{0,63}$",
          "title": "Id",
          "type": "string"
        },
        "issue_state": {
          "enum": [
            "OPEN",
            "CLOSED",
            "unknown"
          ],
          "title": "Issue State",
          "type": "string"
        },
        "pull_requests": {
          "items": {
            "$ref": "#/$defs/ObservedPullRequest"
          },
          "maxItems": 128,
          "title": "Pull Requests",
          "type": "array"
        }
      },
      "required": [
        "id",
        "declared_status",
        "issue_state",
        "evidence_ids"
      ],
      "title": "ObservedStory",
      "type": "object"
    },
    "QACheckResult": {
      "additionalProperties": false,
      "properties": {
        "exit_code": {
          "anyOf": [
            {
              "type": "integer"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Exit Code"
        },
        "finished_at": {
          "minLength": 1,
          "title": "Finished At",
          "type": "string"
        },
        "head_commit": {
          "pattern": "^[0-9a-f]{40}$",
          "title": "Head Commit",
          "type": "string"
        },
        "id": {
          "enum": [
            "lint",
            "format",
            "typing",
            "tests",
            "schemas",
            "repo-policy",
            "sprint-plan"
          ],
          "title": "Id",
          "type": "string"
        },
        "output": {
          "default": "",
          "maxLength": 32768,
          "title": "Output",
          "type": "string"
        },
        "output_sha256": {
          "pattern": "^[0-9a-f]{64}$",
          "title": "Output Sha256",
          "type": "string"
        },
        "request_sha256": {
          "pattern": "^[0-9a-f]{64}$",
          "title": "Request Sha256",
          "type": "string"
        },
        "started_at": {
          "minLength": 1,
          "title": "Started At",
          "type": "string"
        },
        "status": {
          "enum": [
            "passed",
            "failed",
            "timed-out",
            "not-run",
            "output-limit"
          ],
          "title": "Status",
          "type": "string"
        }
      },
      "required": [
        "id",
        "request_sha256",
        "head_commit",
        "status",
        "started_at",
        "finished_at",
        "output_sha256"
      ],
      "title": "QACheckResult",
      "type": "object"
    },
    "QACitation": {
      "additionalProperties": false,
      "properties": {
        "line": {
          "minimum": 1,
          "title": "Line",
          "type": "integer"
        },
        "path": {
          "minLength": 1,
          "title": "Path",
          "type": "string"
        },
        "quote": {
          "maxLength": 1000,
          "minLength": 1,
          "title": "Quote",
          "type": "string"
        }
      },
      "required": [
        "path",
        "line",
        "quote"
      ],
      "title": "QACitation",
      "type": "object"
    },
    "QACriterionResult": {
      "additionalProperties": false,
      "properties": {
        "criterion": {
          "minLength": 1,
          "title": "Criterion",
          "type": "string"
        },
        "criterion_index": {
          "minimum": 0,
          "title": "Criterion Index",
          "type": "integer"
        },
        "finding_ids": {
          "items": {
            "pattern": "^[a-z][a-z0-9_-]{0,63}$",
            "type": "string"
          },
          "maxItems": 32,
          "title": "Finding Ids",
          "type": "array"
        },
        "story_id": {
          "pattern": "^[a-z][a-z0-9_-]{0,63}$",
          "title": "Story Id",
          "type": "string"
        },
        "verification": {
          "const": "not-established",
          "default": "not-established",
          "title": "Verification",
          "type": "string"
        }
      },
      "required": [
        "story_id",
        "criterion_index",
        "criterion",
        "finding_ids"
      ],
      "title": "QACriterionResult",
      "type": "object"
    },
    "QAFindingResolutionProposal": {
      "additionalProperties": false,
      "description": "Evidence for a human decision; never a model-generated resolution.",
      "properties": {
        "check_ids": {
          "items": {
            "enum": [
              "lint",
              "format",
              "typing",
              "tests",
              "schemas",
              "repo-policy",
              "sprint-plan"
            ],
            "type": "string"
          },
          "maxItems": 7,
          "minItems": 1,
          "title": "Check Ids",
          "type": "array"
        },
        "citations": {
          "items": {
            "$ref": "#/$defs/QACitation"
          },
          "maxItems": 8,
          "minItems": 1,
          "title": "Citations",
          "type": "array"
        },
        "current": {
          "$ref": "#/$defs/QAReviewReport"
        },
        "finding_id": {
          "pattern": "^[a-z][a-z0-9_-]{0,63}$",
          "title": "Finding Id",
          "type": "string"
        },
        "previous": {
          "$ref": "#/$defs/QAReviewReport"
        },
        "rationale": {
          "maxLength": 2000,
          "minLength": 1,
          "title": "Rationale",
          "type": "string"
        },
        "schema_version": {
          "const": "QAFindingResolutionProposal/v1",
          "default": "QAFindingResolutionProposal/v1",
          "title": "Schema Version",
          "type": "string"
        },
        "status": {
          "const": "awaiting-human-review",
          "default": "awaiting-human-review",
          "title": "Status",
          "type": "string"
        }
      },
      "required": [
        "previous",
        "current",
        "finding_id",
        "citations",
        "check_ids",
        "rationale"
      ],
      "title": "QAFindingResolutionProposal",
      "type": "object"
    },
    "QAFindingResolutionReview": {
      "additionalProperties": false,
      "properties": {
        "actor": {
          "pattern": "^[a-z][a-z0-9_-]{0,63}$",
          "title": "Actor",
          "type": "string"
        },
        "comment": {
          "maxLength": 2000,
          "minLength": 1,
          "title": "Comment",
          "type": "string"
        },
        "completion_authority": {
          "const": "none",
          "default": "none",
          "title": "Completion Authority",
          "type": "string"
        },
        "decision": {
          "enum": [
            "confirm",
            "reject"
          ],
          "title": "Decision",
          "type": "string"
        },
        "proposal": {
          "$ref": "#/$defs/QAFindingResolutionProposal"
        },
        "reviewed_at": {
          "minLength": 1,
          "title": "Reviewed At",
          "type": "string"
        },
        "schema_version": {
          "const": "QAFindingResolutionReview/v1",
          "default": "QAFindingResolutionReview/v1",
          "title": "Schema Version",
          "type": "string"
        }
      },
      "required": [
        "proposal",
        "decision",
        "actor",
        "reviewed_at",
        "comment"
      ],
      "title": "QAFindingResolutionReview",
      "type": "object"
    },
    "QAInspection": {
      "additionalProperties": false,
      "description": "A model or analyst proposes findings, never check success or closure.",
      "properties": {
        "findings": {
          "items": {
            "$ref": "#/$defs/QAInspectionFinding"
          },
          "maxItems": 32,
          "title": "Findings",
          "type": "array"
        },
        "inspected_facets": {
          "items": {
            "enum": [
              "code",
              "contracts",
              "provenance",
              "security",
              "regressions",
              "business",
              "artifacts"
            ],
            "type": "string"
          },
          "maxItems": 7,
          "title": "Inspected Facets",
          "type": "array"
        },
        "limitations": {
          "items": {
            "minLength": 1,
            "type": "string"
          },
          "maxItems": 32,
          "minItems": 1,
          "title": "Limitations",
          "type": "array"
        },
        "schema_version": {
          "const": "QAInspection/v1",
          "default": "QAInspection/v1",
          "title": "Schema Version",
          "type": "string"
        }
      },
      "required": [
        "limitations"
      ],
      "title": "QAInspection",
      "type": "object"
    },
    "QAInspectionFinding": {
      "additionalProperties": false,
      "properties": {
        "citations": {
          "items": {
            "$ref": "#/$defs/QACitation"
          },
          "maxItems": 8,
          "minItems": 1,
          "title": "Citations",
          "type": "array"
        },
        "criterion_index": {
          "minimum": 0,
          "title": "Criterion Index",
          "type": "integer"
        },
        "facet": {
          "enum": [
            "code",
            "contracts",
            "provenance",
            "security",
            "regressions",
            "business",
            "artifacts"
          ],
          "title": "Facet",
          "type": "string"
        },
        "id": {
          "pattern": "^[a-z][a-z0-9_-]{0,63}$",
          "title": "Id",
          "type": "string"
        },
        "impact": {
          "maxLength": 2000,
          "minLength": 1,
          "title": "Impact",
          "type": "string"
        },
        "recommendation": {
          "maxLength": 2000,
          "minLength": 1,
          "title": "Recommendation",
          "type": "string"
        },
        "reproduction": {
          "maxLength": 2000,
          "minLength": 1,
          "title": "Reproduction",
          "type": "string"
        },
        "severity": {
          "enum": [
            "P0",
            "P1",
            "P2",
            "P3"
          ],
          "title": "Severity",
          "type": "string"
        },
        "story_id": {
          "pattern": "^[a-z][a-z0-9_-]{0,63}$",
          "title": "Story Id",
          "type": "string"
        },
        "title": {
          "maxLength": 200,
          "minLength": 1,
          "title": "Title",
          "type": "string"
        },
        "verification": {
          "const": "not-executed",
          "default": "not-executed",
          "title": "Verification",
          "type": "string"
        }
      },
      "required": [
        "id",
        "severity",
        "facet",
        "story_id",
        "criterion_index",
        "title",
        "impact",
        "recommendation",
        "citations",
        "reproduction"
      ],
      "title": "QAInspectionFinding",
      "type": "object"
    },
    "QAReviewReport": {
      "additionalProperties": false,
      "properties": {
        "acceptance": {
          "const": "not-established",
          "default": "not-established",
          "title": "Acceptance",
          "type": "string"
        },
        "authority": {
          "const": "advisory-only",
          "default": "advisory-only",
          "title": "Authority",
          "type": "string"
        },
        "checks": {
          "items": {
            "$ref": "#/$defs/QACheckResult"
          },
          "maxItems": 7,
          "title": "Checks",
          "type": "array"
        },
        "criterion_count": {
          "minimum": 0,
          "title": "Criterion Count",
          "type": "integer"
        },
        "criterion_matrix": {
          "items": {
            "$ref": "#/$defs/QACriterionResult"
          },
          "maxItems": 4096,
          "title": "Criterion Matrix",
          "type": "array"
        },
        "engine": {
          "enum": [
            "local",
            "codex-cli",
            "ollama",
            "provided-inspection"
          ],
          "title": "Engine",
          "type": "string"
        },
        "inspection": {
          "$ref": "#/$defs/QAInspection"
        },
        "inspection_status": {
          "default": "not-requested",
          "enum": [
            "completed",
            "not-requested",
            "rejected"
          ],
          "title": "Inspection Status",
          "type": "string"
        },
        "missing_facets": {
          "items": {
            "enum": [
              "code",
              "contracts",
              "provenance",
              "security",
              "regressions",
              "business",
              "artifacts"
            ],
            "type": "string"
          },
          "title": "Missing Facets",
          "type": "array"
        },
        "model": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Model"
        },
        "model_attempts": {
          "default": 0,
          "maximum": 1,
          "minimum": 0,
          "title": "Model Attempts",
          "type": "integer"
        },
        "model_calls": {
          "anyOf": [
            {
              "maximum": 1,
              "minimum": 0,
              "type": "integer"
            },
            {
              "type": "null"
            }
          ],
          "default": 0,
          "title": "Model Calls"
        },
        "recommendation": {
          "enum": [
            "changes-required",
            "inconclusive",
            "ready-for-po"
          ],
          "title": "Recommendation",
          "type": "string"
        },
        "request": {
          "$ref": "#/$defs/QAReviewRequest"
        },
        "request_sha256": {
          "pattern": "^[0-9a-f]{64}$",
          "title": "Request Sha256",
          "type": "string"
        },
        "schema_version": {
          "const": "QAReviewReport/v1",
          "default": "QAReviewReport/v1",
          "title": "Schema Version",
          "type": "string"
        }
      },
      "required": [
        "request",
        "request_sha256",
        "engine",
        "inspection",
        "checks",
        "recommendation",
        "missing_facets",
        "criterion_count",
        "criterion_matrix"
      ],
      "title": "QAReviewReport",
      "type": "object"
    },
    "QAReviewRequest": {
      "additionalProperties": false,
      "properties": {
        "author": {
          "pattern": "^[a-z][a-z0-9_-]{0,63}$",
          "title": "Author",
          "type": "string"
        },
        "base_commit": {
          "pattern": "^[0-9a-f]{40}$",
          "title": "Base Commit",
          "type": "string"
        },
        "captured_at": {
          "minLength": 1,
          "title": "Captured At",
          "type": "string"
        },
        "check_ids": {
          "items": {
            "enum": [
              "lint",
              "format",
              "typing",
              "tests",
              "schemas",
              "repo-policy",
              "sprint-plan"
            ],
            "type": "string"
          },
          "title": "Check Ids",
          "type": "array"
        },
        "check_timeout_seconds": {
          "default": 120,
          "maximum": 300,
          "minimum": 1,
          "title": "Check Timeout Seconds",
          "type": "integer"
        },
        "diff": {
          "default": "",
          "maxLength": 65536,
          "title": "Diff",
          "type": "string"
        },
        "diff_sha256": {
          "default": "e3b0c44298fc1c149afbf4c8996fb92427ae41e4649b934ca495991b7852b855",
          "pattern": "^[0-9a-f]{64}$",
          "title": "Diff Sha256",
          "type": "string"
        },
        "excluded_paths": {
          "items": {
            "minLength": 1,
            "type": "string"
          },
          "maxItems": 256,
          "title": "Excluded Paths",
          "type": "array"
        },
        "head_commit": {
          "pattern": "^[0-9a-f]{40}$",
          "title": "Head Commit",
          "type": "string"
        },
        "max_age_seconds": {
          "default": 3600,
          "maximum": 3600,
          "minimum": 60,
          "title": "Max Age Seconds",
          "type": "integer"
        },
        "reviewer": {
          "const": "vera",
          "default": "vera",
          "title": "Reviewer",
          "type": "string"
        },
        "schema_version": {
          "const": "QAReviewRequest/v1",
          "default": "QAReviewRequest/v1",
          "title": "Schema Version",
          "type": "string"
        },
        "snapshot": {
          "$ref": "#/$defs/SprintSnapshot"
        },
        "sources": {
          "items": {
            "$ref": "#/$defs/ReviewSource"
          },
          "maxItems": 32,
          "minItems": 1,
