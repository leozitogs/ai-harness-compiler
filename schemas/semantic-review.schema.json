{
  "$defs": {
    "ItemSupport": {
      "additionalProperties": false,
      "properties": {
        "item_id": {
          "pattern": "^[a-z][a-z0-9_-]{0,63}$",
          "title": "Item Id",
          "type": "string"
        },
        "note": {
          "minLength": 1,
          "title": "Note",
          "type": "string"
        },
        "outcome": {
          "enum": [
            "pass",
            "fail"
          ],
          "title": "Outcome",
          "type": "string"
        },
        "source_refs": {
          "items": {
            "pattern": "^[a-z][a-z0-9_-]{0,63}$",
            "type": "string"
          },
          "maxItems": 32,
          "minItems": 1,
          "title": "Source Refs",
          "type": "array"
        }
      },
      "required": [
        "item_id",
        "source_refs",
        "outcome",
        "note"
      ],
      "title": "ItemSupport",
      "type": "object"
    },
    "RuleCoverage": {
      "additionalProperties": false,
      "properties": {
        "business_rule_id": {
          "pattern": "^[a-z][a-z0-9_-]{0,63}$",
          "title": "Business Rule Id",
          "type": "string"
        },
        "requirement_id": {
          "pattern": "^[a-z][a-z0-9_-]{0,63}$",
          "title": "Requirement Id",
          "type": "string"
        }
      },
      "required": [
        "requirement_id",
        "business_rule_id"
      ],
      "title": "RuleCoverage",
      "type": "object"
    },
    "SemanticCheck": {
      "additionalProperties": false,
      "properties": {
        "criterion": {
          "enum": [
            "rule-coverage",
            "citation-support",
            "conflict-validity",
            "asset-bounds",
            "uncertainty",
            "project-understanding"
          ],
          "title": "Criterion",
          "type": "string"
        },
        "note": {
          "minLength": 1,
          "title": "Note",
          "type": "string"
        },
        "outcome": {
          "enum": [
            "not-run",
            "pass",
            "fail"
          ],
          "title": "Outcome",
          "type": "string"
        }
      },
      "required": [
        "criterion",
        "outcome",
        "note"
      ],
      "title": "SemanticCheck",
      "type": "object"
    }
  },
  "additionalProperties": false,
  "properties": {
    "authority": {
      "const": "human-declared-not-authenticated",
      "default": "human-declared-not-authenticated",
      "title": "Authority",
      "type": "string"
    },
    "case_sha256": {
      "pattern": "^[0-9a-f]{64}$",
      "title": "Case Sha256",
      "type": "string"
    },
    "checks": {
      "items": {
        "$ref": "#/$defs/SemanticCheck"
      },
      "maxItems": 6,
      "minItems": 6,
      "title": "Checks",
      "type": "array"
    },
    "coverage": {
      "items": {
        "$ref": "#/$defs/RuleCoverage"
      },
      "maxItems": 64,
      "title": "Coverage",
      "type": "array"
    },
    "note": {
      "minLength": 1,
      "title": "Note",
      "type": "string"
    },
    "proposal_sha256": {
      "pattern": "^[0-9a-f]{64}$",
      "title": "Proposal Sha256",
      "type": "string"
    },
    "reviewer": {
      "minLength": 1,
      "title": "Reviewer",
      "type": "string"
    },
    "rubric_sha256": {
      "pattern": "^[0-9a-f]{64}$",
      "title": "Rubric Sha256",
      "type": "string"
    },
    "support": {
      "items": {
        "$ref": "#/$defs/ItemSupport"
      },
      "maxItems": 512,
      "title": "Support",
      "type": "array"
    }
  },
  "required": [
    "reviewer",
    "note",
    "case_sha256",
    "rubric_sha256",
    "proposal_sha256",
    "checks"
  ],
  "title": "SemanticReview",
  "type": "object"
}
