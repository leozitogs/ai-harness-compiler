{
  "$defs": {
    "Asset": {
      "additionalProperties": false,
      "properties": {
        "description": {
          "minLength": 1,
          "title": "Description",
          "type": "string"
        },
        "path": {
          "minLength": 1,
          "title": "Path",
          "type": "string"
        }
      },
      "required": [
        "path",
        "description"
      ],
      "title": "Asset",
      "type": "object"
    },
    "BacklogItem": {
      "additionalProperties": false,
      "properties": {
        "acceptance_criteria": {
          "items": {
            "minLength": 1,
            "type": "string"
          },
          "minItems": 1,
          "title": "Acceptance Criteria",
          "type": "array"
        },
        "data_owner": {
          "anyOf": [
            {
              "minLength": 1,
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Data Owner"
        },
        "depends_on": {
          "items": {
            "pattern": "^[a-z][a-z0-9_-]{0,63}$",
            "type": "string"
          },
          "title": "Depends On",
          "type": "array"
        },
        "description": {
          "minLength": 1,
          "title": "Description",
          "type": "string"
        },
        "id": {
          "pattern": "^[a-z][a-z0-9_-]{0,63}$",
          "title": "Id",
          "type": "string"
        },
        "implementation": {
          "default": "undecided",
          "enum": [
            "undecided",
            "deterministic",
            "llm",
            "rag",
            "agent"
          ],
          "title": "Implementation",
          "type": "string"
        },
        "inputs": {
          "items": {
            "minLength": 1,
            "type": "string"
          },
          "title": "Inputs",
          "type": "array"
        },
        "outputs": {
          "items": {
            "minLength": 1,
            "type": "string"
          },
          "title": "Outputs",
          "type": "array"
        },
        "risk": {
          "default": "unknown",
          "enum": [
            "unknown",
            "low",
            "medium",
            "high"
          ],
          "title": "Risk",
          "type": "string"
        },
        "side_effects": {
          "items": {
            "minLength": 1,
            "type": "string"
          },
          "title": "Side Effects",
          "type": "array"
        },
        "title": {
          "minLength": 1,
          "title": "Title",
          "type": "string"
        }
      },
      "required": [
        "id",
        "title",
        "description",
        "acceptance_criteria"
      ],
      "title": "BacklogItem",
      "type": "object"
    },
    "Branding": {
      "additionalProperties": false,
      "properties": {
        "audience": {
          "items": {
            "minLength": 1,
            "type": "string"
          },
          "title": "Audience",
          "type": "array"
        },
        "principles": {
          "items": {
            "minLength": 1,
            "type": "string"
          },
          "title": "Principles",
          "type": "array"
        },
        "tone": {
          "items": {
            "minLength": 1,
            "type": "string"
          },
          "title": "Tone",
          "type": "array"
        },
        "visual_constraints": {
          "items": {
            "minLength": 1,
            "type": "string"
          },
          "title": "Visual Constraints",
          "type": "array"
        }
      },
      "title": "Branding",
      "type": "object"
    },
    "Constraints": {
      "additionalProperties": false,
      "properties": {
        "business": {
          "items": {
            "minLength": 1,
            "type": "string"
          },
          "title": "Business",
          "type": "array"
        },
        "max_build_cost_usd": {
          "default": 0,
          "minimum": 0,
          "title": "Max Build Cost Usd",
          "type": "number"
        },
        "security": {
          "items": {
            "minLength": 1,
            "type": "string"
          },
          "title": "Security",
          "type": "array"
        },
        "technical": {
          "items": {
            "minLength": 1,
            "type": "string"
          },
          "title": "Technical",
          "type": "array"
        }
      },
      "title": "Constraints",
      "type": "object"
    },
    "DomainProfile": {
      "additionalProperties": false,
      "properties": {
        "confidence": {
          "anyOf": [
            {
              "maximum": 1,
              "minimum": 0,
              "type": "number"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Confidence"
        },
        "evidence_ids": {
          "items": {
            "pattern": "^[a-z][a-z0-9_-]{0,63}$",
            "type": "string"
          },
          "title": "Evidence Ids",
          "type": "array"
        },
        "primary": {
          "anyOf": [
            {
              "minLength": 1,
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Primary"
        },
        "status": {
          "enum": [
            "declared",
            "DOMAIN_UNCERTAIN"
          ],
          "title": "Status",
          "type": "string"
        }
      },
      "required": [
        "status"
      ],
      "title": "DomainProfile",
      "type": "object"
    },
    "Evidence": {
      "additionalProperties": false,
      "properties": {
        "claim": {
          "minLength": 1,
          "title": "Claim",
          "type": "string"
        },
        "id": {
          "pattern": "^[a-z][a-z0-9_-]{0,63}$",
          "title": "Id",
          "type": "string"
        },
        "kind": {
          "enum": [
            "declared",
            "derived",
            "research"
          ],
          "title": "Kind",
          "type": "string"
        },
        "source": {
          "minLength": 1,
          "title": "Source",
          "type": "string"
        }
      },
      "required": [
        "id",
        "source",
        "claim",
        "kind"
      ],
      "title": "Evidence",
      "type": "object"
    },
    "ProjectInput": {
      "additionalProperties": false,
      "properties": {
        "assets": {
          "items": {
            "$ref": "#/$defs/Asset"
          },
          "title": "Assets",
          "type": "array"
        },
        "backlog": {
          "items": {
            "$ref": "#/$defs/BacklogItem"
          },
          "minItems": 1,
          "title": "Backlog",
          "type": "array"
        },
        "branding": {
          "$ref": "#/$defs/Branding"
        },
        "conception": {
          "minLength": 1,
          "title": "Conception",
          "type": "string"
        },
        "constraints": {
          "$ref": "#/$defs/Constraints"
        },
        "domain": {
          "anyOf": [
            {
              "minLength": 1,
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Domain"
        },
        "id": {
          "pattern": "^[a-z][a-z0-9_-]{0,63}$",
          "title": "Id",
          "type": "string"
        },
        "name": {
          "minLength": 1,
          "title": "Name",
          "type": "string"
        },
        "schema_version": {
          "const": "ProjectInput/v1",
          "default": "ProjectInput/v1",
          "title": "Schema Version",
          "type": "string"
        }
      },
      "required": [
        "id",
        "name",
        "conception",
        "backlog"
      ],
      "title": "ProjectInput",
      "type": "object"
    }
  },
  "additionalProperties": false,
  "properties": {
    "domain": {
      "$ref": "#/$defs/DomainProfile"
    },
    "evidence": {
      "items": {
        "$ref": "#/$defs/Evidence"
      },
      "minItems": 1,
      "title": "Evidence",
      "type": "array"
    },
    "project": {
      "$ref": "#/$defs/ProjectInput"
    },
    "schema_version": {
      "const": "ProjectDNA/v1",
      "default": "ProjectDNA/v1",
      "title": "Schema Version",
      "type": "string"
    },
    "unknowns": {
      "items": {
        "minLength": 1,
        "type": "string"
      },
      "title": "Unknowns",
      "type": "array"
    }
  },
  "required": [
    "project",
    "domain",
    "evidence"
  ],
  "title": "ProjectDNA",
  "type": "object"
}
