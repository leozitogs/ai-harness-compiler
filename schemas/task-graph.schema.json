{
  "$defs": {
    "Capability": {
      "additionalProperties": false,
      "properties": {
        "acceptance_criteria": {
          "items": {
            "minLength": 1,
            "type": "string"
          },
          "minItems": 1,
          "title": "Acceptance Criteria",
          "type": "array"
        },
        "data_owner": {
          "anyOf": [
            {
              "minLength": 1,
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Data Owner"
        },
        "depends_on": {
          "items": {
            "pattern": "^[a-z][a-z0-9_-]{0,63}$",
            "type": "string"
          },
          "title": "Depends On",
          "type": "array"
        },
        "description": {
          "minLength": 1,
          "title": "Description",
          "type": "string"
        },
        "evidence_ids": {
          "items": {
            "pattern": "^[a-z][a-z0-9_-]{0,63}$",
            "type": "string"
          },
          "minItems": 1,
          "title": "Evidence Ids",
          "type": "array"
        },
        "id": {
          "pattern": "^[a-z][a-z0-9_-]{0,63}$",
          "title": "Id",
          "type": "string"
        },
        "implementation": {
          "default": "undecided",
          "enum": [
            "undecided",
            "deterministic",
            "llm",
            "rag",
            "agent"
          ],
          "title": "Implementation",
          "type": "string"
        },
        "inputs": {
          "items": {
            "minLength": 1,
            "type": "string"
          },
          "title": "Inputs",
          "type": "array"
        },
        "outputs": {
          "items": {
            "minLength": 1,
            "type": "string"
          },
          "title": "Outputs",
          "type": "array"
        },
        "risk": {
          "default": "unknown",
          "enum": [
            "unknown",
            "low",
            "medium",
            "high"
          ],
          "title": "Risk",
          "type": "string"
        },
        "side_effects": {
          "items": {
            "minLength": 1,
            "type": "string"
          },
          "title": "Side Effects",
          "type": "array"
        },
        "title": {
          "minLength": 1,
          "title": "Title",
          "type": "string"
        }
      },
      "required": [
        "id",
        "title",
        "description",
        "acceptance_criteria",
        "evidence_ids"
      ],
      "title": "Capability",
      "type": "object"
    },
    "CapabilityGraph": {
      "additionalProperties": false,
      "properties": {
        "capabilities": {
          "items": {
            "$ref": "#/$defs/Capability"
          },
          "minItems": 1,
          "title": "Capabilities",
          "type": "array"
        },
        "project_id": {
          "pattern": "^[a-z][a-z0-9_-]{0,63}$",
          "title": "Project Id",
          "type": "string"
        },
        "schema_version": {
          "default": "CapabilityGraph/v1",
          "pattern": "^CapabilityGraph/v1$",
          "title": "Schema Version",
          "type": "string"
        }
      },
      "required": [
        "project_id",
        "capabilities"
      ],
      "title": "CapabilityGraph",
      "type": "object"
    },
    "Task": {
      "additionalProperties": false,
      "properties": {
        "acceptance_criteria": {
          "items": {
            "minLength": 1,
            "type": "string"
          },
          "minItems": 1,
          "title": "Acceptance Criteria",
          "type": "array"
        },
        "capability_id": {
          "pattern": "^[a-z][a-z0-9_-]{0,63}$",
          "title": "Capability Id",
          "type": "string"
        },
        "completion_rule": {
          "minLength": 1,
          "title": "Completion Rule",
          "type": "string"
        },
        "deliverables": {
          "items": {
            "minLength": 1,
            "type": "string"
          },
          "minItems": 1,
          "title": "Deliverables",
          "type": "array"
        },
        "depends_on": {
          "items": {
            "pattern": "^[a-z][a-z0-9_-]{0,63}$",
            "type": "string"
          },
          "title": "Depends On",
          "type": "array"
        },
        "id": {
          "pattern": "^[a-z][a-z0-9_-]{0,63}$",
          "title": "Id",
          "type": "string"
        },
        "objective": {
          "minLength": 1,
          "title": "Objective",
          "type": "string"
        },
        "required_context": {
          "items": {
            "minLength": 1,
            "type": "string"
          },
          "minItems": 1,
          "title": "Required Context",
          "type": "array"
        },
        "stage": {
          "enum": [
            "design",
            "implement",
            "verify",
            "review"
          ],
          "title": "Stage",
          "type": "string"
        },
        "status": {
          "const": "planned",
          "default": "planned",
          "title": "Status",
          "type": "string"
        }
      },
      "required": [
        "id",
        "capability_id",
        "stage",
        "objective",
        "depends_on",
        "required_context",
        "deliverables",
        "acceptance_criteria",
        "completion_rule"
      ],
      "title": "Task",
      "type": "object"
    }
  },
  "additionalProperties": false,
  "properties": {
    "declared_completed_capabilities": {
      "items": {
        "pattern": "^[a-z][a-z0-9_-]{0,63}$",
        "type": "string"
      },
      "title": "Declared Completed Capabilities",
      "type": "array"
    },
    "execution_status": {
      "const": "not-run",
      "default": "not-run",
      "title": "Execution Status",
      "type": "string"
    },
    "schema_version": {
      "const": "TaskGraph/v1",
      "default": "TaskGraph/v1",
      "title": "Schema Version",
      "type": "string"
    },
    "selected_capabilities": {
      "items": {
        "pattern": "^[a-z][a-z0-9_-]{0,63}$",
        "type": "string"
      },
      "minItems": 1,
      "title": "Selected Capabilities",
      "type": "array"
    },
    "source_graph": {
      "$ref": "#/$defs/CapabilityGraph"
    },
    "tasks": {
      "items": {
        "$ref": "#/$defs/Task"
      },
      "minItems": 1,
      "title": "Tasks",
      "type": "array"
    }
  },
  "required": [
    "source_graph",
    "selected_capabilities",
    "tasks"
  ],
  "title": "TaskGraph",
  "type": "object"
}
